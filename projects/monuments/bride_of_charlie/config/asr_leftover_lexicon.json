{
  "version": 1,
  "description": "Leftover ASR / caption forms that must be absent from transcripts_corrected before episode_analysis. Aligns with config/transcript_canonical_glossary.json and docs/NAME_FIX_LIST.md.",
  "patterns": [
    {
      "id": "tyler_boyer_variants",
      "regex": "\\bTyler\\s+(?:Boyer|Buer|Ber)\\b",
      "flags": ["IGNORECASE"],
      "note": "Use Tyler Bowyer (COO spelling)"
    },
    {
      "id": "tyler_storm_buer",
      "regex": "\\bTyler\\s+Storm\\s+Buer\\b",
      "flags": ["IGNORECASE"],
      "note": "Use Tyler Storm Bowyer"
    },
    {
      "id": "storm_buer",
      "regex": "\\bStorm\\s+Buer\\b",
      "flags": ["IGNORECASE"],
      "note": "Use Storm Bowyer (Tyler Bowyer; ASR drops given name)"
    },
    {
      "id": "sergeant_ber",
      "regex": "\\b(?:Sergeant|Sgt\\.?)\\s+Ber\\b",
      "flags": ["IGNORECASE"],
      "note": "Use Sgt. Bowyer / Tyler Bowyer (Ber is ASR for Bowyer rank line)"
    },
    {
      "id": "erikica",
      "regex": "\\bErikica\\b",
      "flags": ["IGNORECASE"],
      "note": "Use Erika"
    },
    {
      "id": "erica_kirk",
      "regex": "\\bErica\\s+Kirk\\b",
      "flags": [],
      "note": "House style: Erika Kirk"
    },
    {
