 {
  "claim": "C-2268",
  "episode": 67,
  "attribution": "ok",
  "accuracy": "minor",
  "person": "ok",
  "timestamp": "ok",
  "relevance": "untagged",
  "material": false,
  "note": "The Sept 9 date is the host's reading: at ~39:15 she says 'Josh Hammer came out and clarified that actually Charlie sent that text message on September 9th'. In the clip Hammer says the Zoom call 2 hours later was 'the night before he was killed'; '2025' is not in the window.",
  "fix": {
   "claim": "The host says Josh Hammer clarified that Charlie Kirk's text expressing intent to abandon the pro-Israel cause was sent on September 9, not September 8 as she had stated; in the clip she plays, Hammer says the Zoom call two hours after that screenshot was 'the night before he was killed.'"
  }
 },
 {
  "claim": "C-2269",
  "episode": 67,
  "attribution": "ok",
  "accuracy": "minor",
  "person": "ok",
  "timestamp": "ok",
  "relevance": "untagged",
  "material": false,
  "note": "Hammer says 'I and a few others' were on the call; the rabbi is the host's addition afterwards ('Josh Hammer and a rabbi who lives in Israel'), so the label overstates the clip. Hammer describes the screenshot as Kirk 'upset that a Jewish donor was withholding his $2 million donation'.",
  "fix": {
   "label": "Josh Hammer Describes Sept 9 Zoom Call With Charlie Kirk"
  }
 },
