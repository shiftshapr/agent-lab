  "episode": 79,
  "attribution": "ok",
  "accuracy": "minor",
  "person": "ok",
  "timestamp": "ok",
  "relevance": "untagged",
  "material": false,
  "note": "'I was in the White House all day fighting for America' is Kirk's text in the back-and-forth Weinstein shares (12:38), not part of Weinstein's own statement.",
  "fix": {
   "claim": "Per a statement by Bret Weinstein that the host reads, Weinstein says that in a June 18 text exchange Charlie Kirk told him he was \"spending two full days at the White House trying to persuade President Trump not to initiate a war with Iran,\" and in the texts Weinstein shares, Kirk wrote that he was \"in the White House all day fighting for America.\""
  }
 },
 {
  "claim": "C-2480",
  "episode": 79,
  "attribution": "ok",
  "accuracy": "minor",
  "person": "ok",
  "timestamp": "ok",
  "relevance": "untagged",
  "material": false,
  "note": "Transcript: 'He then shares this back and forth communication' - the window does not say this exchange is the June 18 one; date is an addition.",
  "fix": {
   "claim": "In a text exchange Bret Weinstein shared, which the host reads, Weinstein wrote \"We have to shut these maniacs down\" regarding neocons advocating war with Iran, and Charlie Kirk replied \"thank you. I totally agree.\""
  }
 },
