 {
  "claim": "C-3180",
  "episode": 135,
  "attribution": "ok",
  "accuracy": "minor",
  "person": "ok",
  "timestamp": "ok",
  "relevance": "untagged",
  "material": false,
  "note": "Email: \"his neck should have been stabilized before moving him\"; it does not state it was not. \"I think it wasn't stabilized because they were hiding...\" is the host's own addition.",
  "fix": {
   "claim": "Per the anesthesiologist's email, no ambulance with resuscitative equipment or trained personnel was immediately available at the scene (no defibrillators, no access to IV drugs), and Charlie's neck should have been stabilized before moving him."
  }
 },
 {
  "claim": "C-3181",
  "episode": 135,
  "attribution": "error",
  "accuracy": "ok",
  "person": "ok",
  "timestamp": "ok",
  "relevance": "untagged",
  "material": true,
  "note": "\"Rushed\" is the host's own comment after the email (\"It was rushed\"), not the email. Email: \"at least eight hours\" to 40 degrees; \"about three hours... depending on how much time Erika spent with him\".",
  "fix": {
   "claim": "Per the transplant coordinator's email the host reads, it takes at least eight hours for deep core body temperature to reach 40 degrees in a morgue cooler, so the timeline would only support about three hours in the morgue, depending on how much time Erika spent with him; the host then says the autopsy was rushed.",
   "mentions": [
    "N-1",
    "N-2"
   ]
  }
 },
