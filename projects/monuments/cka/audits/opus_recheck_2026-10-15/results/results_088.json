  "episode": 59,
  "attribution": "error",
  "accuracy": "ok",
  "person": "ok",
  "timestamp": "ok",
  "relevance": "ok",
  "material": true,
  "note": "The speaker who flew the survey drone is the Paramount Tactical guest (Gary), not Kolvet: Kolvet later says \"I completely understand Gary\"; host: \"We were just told by Paramount Tactical and Andrew\"; ep 100: \"Gary, that's Paramount Tactical\".",
  "fix": {
   "claim": "In a clip the host plays, Paramount Tactical's Gary says his drone pilot had already made all the necessary steps with the FAA to be able to fly the drone for the survey.",
   "label": "Paramount Tactical's Gary Says His Drone Pilot Had Completed the FAA Steps",
   "mentions": []
  }
 },
 {
  "claim": "C-14210",
  "episode": 59,
  "attribution": "error",
  "accuracy": "ok",
  "person": "ok",
  "timestamp": "ok",
  "relevance": "ok",
  "material": true,
  "note": "Speaker who went to UVU and was told to ground the drone is the Paramount Tactical guest (Gary), whom Kolvet addresses (\"I completely understand Gary\"), not Kolvet.",
  "fix": {
   "claim": "In a clip the host plays, Paramount Tactical's Gary says that at UVU law enforcement came up and demanded he take the drone down, that he told the officer they did not control the airspace, and that they ended up grounding it.",
   "label": "Paramount Tactical's Gary Says Law Enforcement Made Him Ground the Drone at UVU",
   "mentions": []
  }
 },
 {
  "claim": "C-14211",
  "episode": 59,
  "attribution": "error",
  "accuracy": "ok",
  "person": "ok",
  "timestamp": "ok",
  "relevance": "ok",
  "material": true,
  "note": "\"We were off campus. We flew the drone... reinforced other people saying, Brian Harpole specifically\" is the Paramount Tactical guest (Gary), not Kolvet.",
  "fix": {
   "claim": "In a clip the host plays, Paramount Tactical's Gary says that after being grounded they left campus, flew the drone off campus and got the survey, and that this reinforced Harpole's statement that they could not get permission to get a drone up.",
   "label": "Paramount Tactical's Gary Says the Team Left Campus, Flew the Drone and Got the Survey",
   "mentions": [
    "N-267"
   ]
  }
 },
